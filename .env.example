# FinGuard Orchestrator -- environment template.
#
#   cp .env.example .env    then fill in the blanks
#
# .env is gitignored; this template is tracked and must never contain a real secret.
# Anything with a default already works -- only the blank values need you.


# --- Dataset acquisition (§3.2) -------------------------------------------------------
# Nothing required. SAML-D downloads from Kaggle anonymously and the regulatory corpus is
# fetched over plain HTTPS. A Kaggle token at ~/.kaggle/kaggle.json is only a fallback for
# when the anonymous download is rate limited.

# Optional: raises the Hugging Face download rate limit for the sentence-transformers model.
HF_TOKEN=


# --- The reasoning provider -----------------------------------------------------------
# Required for the grounding and critic calls, the light-model extraction fallback, and the
# eval suite's narrative judge. The retrieval pipeline -- embeddings, vector store, reranker --
# runs fully in-environment and needs none of this (HLD §5).
LLM_API_KEY=

# Model tiering (HLD §4): the strong model is reserved for judgement and grounding; the light
# one only rescues statement lines the deterministic parser refused.
REASONING_MODEL=gpt-4o
LIGHT_MODEL=gpt-4o-mini
LLM_TEMPERATURE=0
EVAL_MODEL=gpt-4o


# --- Vector store and local models ----------------------------------------------------
# Two collections. `rule_chunks` is the citable US knowledge base -- nothing outside US
# jurisdiction may enter it. `obliqa_benchmark` holds the 40 ADGM documents purely so the
# 2,786-question retrieval benchmark stays reproducible; it is never retrieved from at runtime,
# which is what guarantees an out-of-jurisdiction clause cannot be cited.
CHROMA_DB_PATH=./chroma_db
RULE_COLLECTION=rule_chunks
BENCHMARK_COLLECTION=obliqa_benchmark

# Local, in-environment, no per-call cost. The dimension is configuration rather than a constant
# because a collection built at one dimension cannot answer a query embedded at another, and the
# failure is a silent distance rather than an exception.
EMBEDDING_MODEL=all-MiniLM-L6-v2
EMBEDDING_DIMENSION=384
CROSS_ENCODER_MODEL=ms-marco-TinyBERT-L-2-v2


# --- Results store (LLD §3.2) ---------------------------------------------------------
# Reports are immutable once written; review actions land in a separate append-only table.
# SQLite for v1, Postgres in production.
RESULTS_DB_URL=sqlite:///./results.db


# --- API (LLD §2 Group 5) -------------------------------------------------------------
# A bearer token is checked in middleware; every request without it is a 401. Generate one with
# `openssl rand -hex 32`.
API_AUTH_TOKEN=
API_HOST=0.0.0.0
API_PORT=8000


# --- Tunables -------------------------------------------------------------------------
# Every threshold, window, count and k lives in config.yaml, not here. Secrets never in the
# file, numbers never in the environment (LLD §8).
CONFIG_PATH=./config.yaml
ENV=dev


# --- Observability: Langfuse, self-hosted (HLD §6) ------------------------------------
# Traces carry reasoning over transaction data, so they stay in-environment. Tracing needs the
# flag *and* both keys -- a flag alone was a silent no-op in the pre-migration tracing wiring.
# Identifiers are redacted before any payload is emitted (src/utils/redaction.py).
LANGFUSE_TRACING=false
LANGFUSE_HOST=http://localhost:3000
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
# Separates one deployment's traces from another's inside the same Langfuse project.
LANGFUSE_ENVIRONMENT=development

# HLD §6 asks for a client-tier tag so runs can be filtered and compared across tiers. The engine
# has no notion of a client -- one deployment audits one institution -- so this is a deployment
# label rather than a lookup.
CLIENT_TIER=unspecified

# Optional. Breaks cross-run correlation of pseudonymised account tokens, at the cost of being
# unable to compare one trace to the next. Left empty on synthetic data.
REDACTION_PEPPER=


# --- Evaluation (§8) ------------------------------------------------------------------
# DeepEval runs locally against OPENAI_API_KEY. This key is only needed if you want results
# pushed to the Confident AI dashboard.
DEEPEVAL_API_KEY=
