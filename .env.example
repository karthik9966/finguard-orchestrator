# FinGuard Orchestrator -- environment template.
#
#   cp .env.example .env    then fill in the blanks
#
# .env is gitignored; this template is tracked and must never contain a real secret.
# Anything with a default already works -- only the blank values need you.


# --- Dataset acquisition (§3.2) -------------------------------------------------------
# Nothing required. SAML-D downloads from Kaggle anonymously and the regulatory corpus is
# fetched over plain HTTPS. A Kaggle token at ~/.kaggle/kaggle.json is only a fallback for
# when the anonymous download is rate limited.

# Optional: raises the Hugging Face download rate limit for the sentence-transformers model.
HF_TOKEN=


# --- OpenAI (§3.3 embeddings, §4.2 agent nodes, §8 eval judge) ------------------------
# Required for: the text-embedding-3-small benchmark arm, the LangGraph nodes, DeepEval.
# The minilm embedding backend needs none of this and runs fully offline.
OPENAI_API_KEY=

# Models, pinned to what the blueprint specifies. Kept configurable because §9.2's
# hierarchical routing is precisely about sending cheap work to a cheap model.
EMBEDDING_MODEL=text-embedding-3-small
EXTRACTION_MODEL=gpt-4o-mini
AUDIT_MODEL=gpt-4o
EVAL_MODEL=gpt-4o


# --- ChromaDB (§3.4) ------------------------------------------------------------------
# One collection, `regulations`. Transactions are not embedded -- parsed wires live in
# data/processed/parsed/ and are queried with SQL.
CHROMA_PERSIST_DIR=./chroma_db
CHROMA_COLLECTION=regulations


# --- LangSmith tracing (§7.1) ---------------------------------------------------------
# Variable names are taken verbatim from the blueprint. Leave tracing false until you have
# a key, or every run will emit connection warnings.
LANGCHAIN_TRACING_V2=false
LANGCHAIN_API_KEY=
LANGCHAIN_PROJECT=finguard-orchestrator


# --- Redis semantic cache (§9.3) ------------------------------------------------------
# Caches audits keyed on the *candidate narrative*, not on raw wires. Threshold 0.95 is the
# blueprint's cache-hit cutoff in the §9.1 topology.
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0
SEMANTIC_CACHE_THRESHOLD=0.95


# --- Evaluation (§8) ------------------------------------------------------------------
# DeepEval runs locally against OPENAI_API_KEY. This key is only needed if you want results
# pushed to the Confident AI dashboard.
DEEPEVAL_API_KEY=
