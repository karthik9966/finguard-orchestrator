# Python
__pycache__/
*.py[cod]
.venv/
*.egg-info/
.pytest_cache/
.ruff_cache/

# Env / secrets
.env
.env.local
# .env.example is the tracked template README tells you to copy -- it holds no secrets.
!.env.example

# Data & stores (large / generated)
data/raw/
data/processed/
chroma_db/
# docs/ holds two kinds of thing: the engineering artifacts are source and belong in a diff like
# code, while the blueprint PDF and the rendered graph are an input and a build output.
# `docs/*` rather than `docs/` -- git cannot re-include a file whose parent *directory* is
# excluded, so with `docs/` the negation below is silently dead.
docs/*
!docs/*.md
*.sqlite3

# OS / editor
.DS_Store
.idea/
.vscode/

# Claude Code local settings
.claude/settings.local.json
